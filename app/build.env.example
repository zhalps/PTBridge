# ===========================================================================
# PTBridge 构建配置 —— 复制本文件为 build.env 再改（build.env 已被 .gitignore 忽略）
#
#   cp build.env.example build.env
#
# 本文件按 shell 语法读取，等号两边不要有空格，路径含空格要用引号包起来。
# 任何一项都可以用同名环境变量覆盖。
# ===========================================================================

# ---- Android SDK 根目录（里面应有 platforms/ 、build-tools/ 、cmdline-tools/）----
ANDROID_SDK="/c/Android/sdk"

# ---- JDK 17 根目录（手工编译只需 javac + java，无需完整 Android Studio）----
JDK17="/c/Program Files/Java/jdk-17"

# ---- 可选：想覆盖默认值时才填 ----
# ANDROID_JAR="$ANDROID_SDK/platforms/android-30/android.jar"
# BUILD_TOOLS="$ANDROID_SDK/build-tools/34.0.0"
# R8_JAR="$ANDROID_SDK/cmdline-tools/lib/r8.jar"

# ---- 签名 ----
# ⚠️ 升装现有 App 必须沿用同一把 keystore，否则 Android 会拒绝覆盖安装。
#    keystore 与 build.env 都不要提交到仓库。
KEYSTORE="/path/to/your-release.keystore"
KS_ALIAS="release"
KS_PASS=""
KEY_PASS="$KS_PASS"
